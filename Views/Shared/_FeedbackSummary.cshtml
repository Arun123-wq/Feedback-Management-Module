@model FeedbackListViewModel

<div class="row g-3 mb-4 text-center">
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="display-6">@Model.Total</div>
            <div class="text-muted">Total Feedback</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="display-6">@Model.AverageRating.ToString("0.0")</div>
            <div>@Html.RatingStars((int)Math.Round(Model.AverageRating))</div>
            <div class="text-muted">Average Rating</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="display-6">@Model.RecommendCount</div>
            <div class="text-muted">Would Recommend</div>
        </div></div>
    </div>
</div>
