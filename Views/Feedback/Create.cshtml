@model Feedback
@{
    ViewData["Title"] = "Give Feedback";
}

<h2 class="mb-3">Give Feedback</h2>

<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_FeedbackForm", Model)

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Submit Feedback</button>
                @Html.ActionLink("Cancel", "Index", "Feedback", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
