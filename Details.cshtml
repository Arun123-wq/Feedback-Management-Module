@model Feedback
@{
    ViewData["Title"] = "Feedback Details";
}

<h2 class="mb-3">Feedback Details</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Category)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Category)</dd>

            <dt class="col-sm-3">Rating</dt>
            <dd class="col-sm-9">@Html.RatingStars(Model.Rating) (@Model.Rating/5)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Comments)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Comments)</dd>

            <dt class="col-sm-3">Would Recommend</dt>
            <dd class="col-sm-9">@(Model.WouldRecommend ? "Yes" : "No")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.VisitDate)</dt>
            <dd class="col-sm-9">@Model.VisitDate?.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SubmittedOn)</dt>
            <dd class="col-sm-9">@Model.SubmittedOn.ToString("dd MMM yyyy, hh:mm tt")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @Html.ActionLink("Edit", "Edit", "Feedback", new { id = Model.Id }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to List", "Index", "Feedback", null, new { @class = "btn btn-outline-secondary" })
</div>
