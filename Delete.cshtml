@model Feedback
@{
    ViewData["Title"] = "Delete Feedback";
}

<h2 class="mb-3 text-danger">Delete Feedback</h2>
<div class="alert alert-warning">Are you sure you want to delete this feedback? This cannot be undone.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <p><strong>@Model.Name</strong> &middot; @Model.Category &middot; @Html.RatingStars(Model.Rating)</p>
        <p class="mb-0">@Model.Comments</p>
    </div>
</div>

@using (Html.BeginForm("Delete", "Feedback", new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    @Html.ActionLink("Cancel", "Index", "Feedback", null, new { @class = "btn btn-outline-secondary" })
}
